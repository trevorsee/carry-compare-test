generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum PaymentStyle {
  upfront
  reimbursement
  mixed
  unknown
}

enum AttorneyChoice {
  yes
  limited
  no
  unknown
}

enum CoverageType {
  criminal
  civil
  both
  unknown
}

enum FamilyCoverage {
  yes
  limited
  no
  unknown
}

model Provider {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  websiteUrl      String
  logoUrl         String?
  summaryShort    String?
  summaryLong     String?
  disclosureNotes String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans Plan[]
}

model Plan {
  id                   String         @id @default(uuid())
  providerId           String
  name                 String
  slug                 String         @unique
  priceMonthly         Float?
  priceAnnual          Float?
  paymentStyle         PaymentStyle   @default(unknown)
  attorneyChoice       AttorneyChoice @default(unknown)
  waitingPeriodDays    Int?
  coverageType         CoverageType   @default(unknown)
  familyCoverage       FamilyCoverage @default(unknown)
  coverageNotes        String?
  exclusionsNotes      String?
  supportFeatures      Json?
  limitsJson           Json?
  availabilityJson     Json?
  affiliateUrl         String?
  ctaLabel             String?
  isFeatured           Boolean        @default(false)
  isSponsored          Boolean        @default(false)
  sponsoredRankPosition Int?
  overallScore         Float?
  scoreBreakdownJson   Json?
  lastVerifiedAt       DateTime?
  isActive             Boolean        @default(true)
  isPublished          Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  provider  Provider   @relation(fields: [providerId], references: [id])
  sources   Source[]
  changeLog ChangeLog[]

  @@index([providerId])
  @@index([isActive, isPublished])
}

model Source {
  id         String   @id @default(uuid())
  planId     String
  url        String
  title      String?
  note       String?
  capturedAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model ChangeLog {
  id        String   @id @default(uuid())
  planId    String
  changedAt DateTime @default(now())
  changedBy String?
  summary   String
  diffJson  Json?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, changedAt])
}

model Event {
  id        String   @id @default(uuid())
  name      String
  payload   Json
  pagePath  String?
  createdAt DateTime @default(now())
}

